<!DOCTYPE html>
<html lang="en">
<head>
   <%- include("./partials/head") %>
    <title>Me</title>
</head>
<body>
 <%- include("./partials/navbar") %> 
  <div class="container mt-3">
    <div>
        <h1>My Blogs</h1>
        <% if (locals.blogs.length === 0) { %>
          <h3>No blogs found. Create your first blog!</h3>
        <% } %>
    </div>
   <div class="row gap-4 row-cols-4">
    <% blogs.forEach(blog => { %>
     <div class="card" style="width: 18rem;">
      <img src="<%= blog.coverImageUrl %>" class="card-img-top" >
       <div class="card-body">
        <h5 class="card-title"><%= blog.title %></h5>
        <a href="/blog/<%= blog._id %>" class="btn btn-primary">View</a>
        <a href="/delete/<%= blog._id %>" class="btn btn-danger">delete</a>
       </div>
     </div>
    <% }) %>
   </div>
  </div>
 <%-include("./partials/script") %>    
</body>
</html>